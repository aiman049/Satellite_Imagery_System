<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/json");

// Get country name from URL
$country = $_GET['country'];

// Connect to MySQL
$conn = mysqli_connect("localhost", "root", "", "SatelliteIDB");

// Check connection
if (!$conn) {
    echo json_encode(["error" => "Connection failed: " . mysqli_connect_error()]);
    die();
}

// Search for image by country name
$query = "SELECT i.File_Path, c.Name as country 
          FROM Images i 
          JOIN Country c ON i.CountryID = c.CountryID 
          WHERE c.Name = ?";

$stmt = mysqli_prepare($conn, $query);
mysqli_stmt_bind_param($stmt, "s", $country);
mysqli_stmt_execute($stmt);
$result = mysqli_stmt_get_result($stmt);
$row = mysqli_fetch_assoc($result);

if ($row) {
    echo json_encode([
        "country" => $row['country'],
        "image_url" => $row['File_Path']
    ]);
} else {
    echo json_encode(["error" => "No image found for " . $country]);
}

mysqli_close($conn);
?>
