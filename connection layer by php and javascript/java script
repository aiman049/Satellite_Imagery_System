<script>
        function loadImage() {
            let country = document.getElementById("country-select").value;

            if (country === "") {
                alert("Please select a country!");
                return;
            }

            fetch("fetch_image.php?country=" + country)
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        document.getElementById("result").innerHTML =
                            "<p>No image found for " + country + "</p>";
                    } else {
                        document.getElementById("result").innerHTML =
                            "<h2>" + data.country + "</h2>" +
                            "<img src='" + data.image_url + "' width='600px'/>";
                    }
                });
        }
    </script>
